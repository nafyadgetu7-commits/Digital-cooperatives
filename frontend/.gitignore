
# ==========================================
# DIGITAL COOPERATIVE MANAGEMENT SYSTEM
# Root Git Ignore Configuration
# ==========================================

# Environment variables and sensitive files
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Node.js dependencies
node_modules/
**/node_modules/

# React production builds
build/
dist/
frontend/build/
frontend/dist/

# Testing and coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Uploads and user-generated files
backend/uploads/
uploads/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# IDE and editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment and local configuration
.env.local
.env.development.local
.env.test.local
.env.production.local

# Package manager caches
.npm/
.eslintcache
.parcel-cache/

# Python cache (if used)
__pycache__/
*.py[cod]
venv/
.venv/

# Database backups
*.sql.bak
*.dump
